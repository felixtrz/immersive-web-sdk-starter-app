<!--
  Live race HUD bar. Ids are the contract with HudSystem:
  hud-root, hud-lap, hud-time, hud-best, hud-delta, hud-speed.
-->
<style>
  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwAkJxhTg.ttf");
    font-weight: 500;
  }

  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwARZthTg.ttf");
    font-weight: 700;
  }

  .bar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 600px;
    height: 76px;
    padding-left: 22px;
    padding-right: 22px;
    gap: 18px;
    border-radius: 20px;
    background-color: rgba(18, 22, 29, 0.82);
    font-family: "DM Sans";
  }

  .cell {
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
  }

  .label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    color: rgba(255, 255, 255, 0.55);
  }

  .value {
    font-size: 26px;
    font-weight: 700;
    color: #ffffff;
  }

  .speed-cell {
    flex-direction: row;
    align-items: flex-end;
    gap: 6px;
    padding-left: 18px;
    border-left-width: 2px;
    border-color: rgba(255, 255, 255, 0.18);
  }

  .speed {
    font-size: 38px;
    font-weight: 700;
    color: #f07a1a;
  }

  .unit {
    font-size: 13px;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.55);
    padding-bottom: 8px;
  }
</style>
<div id="hud-root" class="bar">
  <div class="cell">
    <div class="label">LAP</div>
    <div id="hud-lap" class="value">1/3</div>
  </div>
  <div class="cell">
    <div class="label">TIME</div>
    <div id="hud-time" class="value">0:00.00</div>
  </div>
  <div class="cell">
    <div class="label">BEST</div>
    <div id="hud-best" class="value">--:--.--</div>
  </div>
  <div class="cell">
    <div class="label">DELTA</div>
    <div id="hud-delta" class="value">+0.00</div>
  </div>
  <div class="speed-cell">
    <div id="hud-speed" class="speed">0</div>
    <div class="unit">KM/H</div>
  </div>
</div>
