<!--
  Steering-column data display (MyChron style), 560 x ~250 units at scale 0.05 = 28 cm wide.
  Ids are the contract with DashboardSystem (src/systems/dashboard.ts):
  speed, lap, time, best, delta, status, light-1..3, thr-fill, brk-fill.
-->
<style>
  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwARZthTg.ttf");
    font-weight: 700;
  }

  .dash {
    flex-direction: column;
    width: 560px;
    padding: 16px;
    gap: 10px;
    border-radius: 18px;
    background-color: #14171b;
    font-family: "DM Sans";
    font-weight: 700;
  }

  .row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }

  .lights {
    flex-direction: row;
    gap: 8px;
  }

  .light {
    width: 26px;
    height: 26px;
    border-radius: 13px;
    background-color: #3a3f47;
  }

  .status {
    flex-grow: 1;
    text-align: right;
    color: #f4f1ea;
    font-size: 30px;
  }

  .pedal {
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .track {
    flex-direction: column;
    justify-content: flex-end;
    width: 22px;
    height: 150px;
    border-radius: 6px;
    background-color: #2a3038;
  }

  .thr {
    width: 22px;
    height: 150px;
    border-radius: 6px;
    background-color: #f07a1a;
  }

  .brk {
    width: 22px;
    height: 150px;
    border-radius: 6px;
    background-color: #e8322b;
  }

  .tag {
    color: #9aa3ad;
    font-size: 13px;
  }

  .side {
    flex-direction: column;
    gap: 10px;
    width: 120px;
  }

  .center {
    flex-direction: column;
    align-items: center;
    flex-grow: 1;
  }

  .speed {
    color: #ffffff;
    font-size: 96px;
    line-height: 96px;
  }

  .unit {
    color: #f07a1a;
    font-size: 18px;
  }

  .cell {
    flex-direction: column;
    gap: 2px;
  }

  .label {
    color: #9aa3ad;
    font-size: 14px;
  }

  .value {
    color: #ffffff;
    font-size: 28px;
  }
</style>
<div class="dash">
  <div class="row">
    <div class="lights">
      <div id="light-1" class="light"></div>
      <div id="light-2" class="light"></div>
      <div id="light-3" class="light"></div>
    </div>
    <div id="status" class="status">READY</div>
  </div>
  <div class="row">
    <div class="pedal">
      <div class="track">
        <div id="brk-fill" class="brk"></div>
      </div>
      <div class="tag">BRK</div>
    </div>
    <div class="side">
      <div class="cell">
        <div class="label">LAP</div>
        <div id="lap" class="value">1/3</div>
      </div>
      <div class="cell">
        <div class="label">TIME</div>
        <div id="time" class="value">0:00.00</div>
      </div>
    </div>
    <div class="center">
      <div id="speed" class="speed">0</div>
      <div class="unit">KM/H</div>
    </div>
    <div class="side">
      <div class="cell">
        <div class="label">BEST</div>
        <div id="best" class="value">--:--.--</div>
      </div>
      <div class="cell">
        <div class="label">DELTA</div>
        <div id="delta" class="value">--.--</div>
      </div>
    </div>
    <div class="pedal">
      <div class="track">
        <div id="thr-fill" class="thr"></div>
      </div>
      <div class="tag">THR</div>
    </div>
  </div>
</div>
