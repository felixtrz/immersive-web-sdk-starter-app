<!--
  Cockpit dashboard. The element ids are the contract with DashboardSystem
  (src/systems/dashboard.ts): speed, lap, time, best, delta, status, light-1..3.
-->
<style>
  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwARZthTg.ttf");
    font-weight: 700;
  }

  .dash {
    flex-direction: column;
    width: 520px;
    padding: 16px;
    gap: 10px;
    border-radius: 18px;
    background-color: #1b1f24;
    font-family: "DM Sans";
    font-weight: 700;
  }

  .row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .lights {
    flex-direction: row;
    gap: 10px;
  }

  .light {
    width: 34px;
    height: 34px;
    border-radius: 17px;
    background-color: #3a3f47;
  }

  .status {
    color: #f4f1ea;
    font-size: 22px;
  }

  .speed-box {
    flex-direction: row;
    align-items: flex-end;
    gap: 6px;
  }

  .speed {
    color: #ffffff;
    font-size: 72px;
    line-height: 72px;
  }

  .unit {
    color: #f07a1a;
    font-size: 20px;
    padding-bottom: 10px;
  }

  .cell {
    flex-direction: column;
    gap: 2px;
  }

  .label {
    color: #9aa3ad;
    font-size: 16px;
  }

  .value {
    color: #ffffff;
    font-size: 30px;
  }

  .delta {
    color: #7fd4ff;
    font-size: 30px;
  }
</style>
<div class="dash">
  <div class="row">
    <div class="lights">
      <div id="light-1" class="light"></div>
      <div id="light-2" class="light"></div>
      <div id="light-3" class="light"></div>
    </div>
    <div id="status" class="status">Throttle to start</div>
  </div>
  <div class="row">
    <div class="speed-box">
      <div id="speed" class="speed">0</div>
      <div class="unit">km/h</div>
    </div>
    <div class="cell">
      <div class="label">LAP</div>
      <div id="lap" class="value">1/3</div>
    </div>
  </div>
  <div class="row">
    <div class="cell">
      <div class="label">TIME</div>
      <div id="time" class="value">0:00.00</div>
    </div>
    <div class="cell">
      <div class="label">BEST</div>
      <div id="best" class="value">--:--.--</div>
    </div>
    <div class="cell">
      <div class="label">DELTA</div>
      <div id="delta" class="delta">+0.00</div>
    </div>
  </div>
</div>
